{
  "name": "smashup-derby",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:browser": "vite build --config vite.browser.config.ts",
    "build:performance": "vite build --config vite.performance.config.ts",
    "preview": "vite preview",
    "check:repo": "node scripts/check-repo-legibility.mjs",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:browser": "playwright test --grep-invert @performance",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage && node scripts/check-test-coverage.mjs",
    "validate": "npm run check:repo && npm run typecheck && npm run build && npm run test:coverage && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": ">=1.63.0",
    "@types/node": ">=26.6.4",
    "@vitest/coverage-v8": ">=5.0.3",
    "jsdom": ">=30.1.1",
    "typescript": ">=7.0.2",
    "vite": ">=8.3.2",
    "vitest": ">=5.0.3"
  },
  "allowScripts": {
    "fsevents": true
  }
}
